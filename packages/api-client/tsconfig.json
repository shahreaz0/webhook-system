{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "types": ["bun"],
    "paths": {
      "@/api/*": ["../../apps/api/src/*"]
    }
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/packages/web"]
  },
  "include": ["src/**/*"]
}
