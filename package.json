{
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "typescript": "^7.0.0",
    "ultracite": "7.7.0"
  },
  "name": "xwebhook-system",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter @xwebhook/web",
    "dev:api": "turbo dev --filter @xwebhook/api",
    "dev:automator": "turbo dev --filter @xwebhook/automator",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "generate": "turbo generate --filter @xwebhook/database",
    "migrate": "bun run --cwd packages/database migrate",
    "prepare": "husky"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  }
}
