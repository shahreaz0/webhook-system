{
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0"
  },
  "name": "webhook-system",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @webhook/web dev",
    "dev:api": "bun run --filter @webhook/api dev",
    "dev:automator": "bun run --filter @webhook/automator dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "generate": "bun run --filter @webhook/database generate",
    "migrate": "bun run --cwd packages/database migrate",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true
}
